---
import { me, roles } from '../data/site';
---

<div class="hero">
  <div>
    <h1 class="reveal">{me.handle}</h1>
    <p class="name reveal" style="animation-delay: 0.1s">
      {me.name} — <span id="typed" data-roles={JSON.stringify(roles)}>{roles[0]}</span>
    </p>
    <p class="lead reveal" style="animation-delay: 0.2s">
      Berusia {me.age} tahun, belajar software engineering sejak {me.since}. Saya membangun aplikasi web
      yang <strong>dipakai untuk urusan nyata</strong>: reservasi, kasir, dan perpustakaan.
    </p>
  </div>
  <svg class="net reveal" style="animation-delay: 0.3s" viewBox="0 0 240 240" role="img" aria-label="Ilustrasi jaringan node">
    <g>
      <line x1="120" y1="120" x2="40" y2="50" /><line x1="120" y1="120" x2="200" y2="40" />
      <line x1="120" y1="120" x2="210" y2="150" /><line x1="120" y1="120" x2="70" y2="205" />
      <line x1="40" y1="50" x2="200" y2="40" /><line x1="200" y1="40" x2="210" y2="150" />
      <line x1="210" y1="150" x2="70" y2="205" /><line x1="70" y1="205" x2="40" y2="50" />
      <line x1="40" y1="50" x2="18" y2="130" /><line x1="18" y1="130" x2="70" y2="205" />
    </g>
    <circle cx="40" cy="50" r="6" /><circle cx="200" cy="40" r="6" />
    <circle cx="210" cy="150" r="6" /><circle cx="70" cy="205" r="6" />
    <circle cx="18" cy="130" r="4" />
    <circle class="core" cx="120" cy="120" r="9" />
  </svg>
</div>